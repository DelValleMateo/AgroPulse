# AgroPulse Infrastructure Environment Variables

# Supabase Configuration
# For local Supabase CLI or docker:
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Redpanda / Kafka
KAFKA_BROKERS=redpanda:29092

# Simulator Settings
SIMULATOR_PORT=4000
TICK_INTERVAL_MS=4000

# Optional failure simulation for academic demonstration (0.0 = 0%, 0.1 = 10% timeout errors)
VALVE_FAILURE_RATE=0.0
