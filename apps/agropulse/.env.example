# AgroPulse Mobile App Environment Variables
# RNF-02: No service role keys in mobile app binary! Only public URL and anon key.

EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Default test credentials for fast login during demonstration
EXPO_PUBLIC_DEMO_PRODUCER_EMAIL=productor@agropulse.test
EXPO_PUBLIC_DEMO_OPERATOR_EMAIL=operador@agropulse.test
EXPO_PUBLIC_DEMO_ADVISOR_EMAIL=asesor@agropulse.test
EXPO_PUBLIC_DEMO_PASSWORD=AgroPulse2026!
